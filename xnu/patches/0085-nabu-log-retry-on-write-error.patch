--- a/bsd/dev/nabu_ufs.c
+++ b/bsd/dev/nabu_ufs.c
@@ -741,6 +741,7 @@
 {
 	uint64_t base = su.first_block + su.nblocks - NABU_LOG_BLOCKS;
 	uint64_t flushed = 0, seq = 0;
+	uint32_t failures = 0;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
 
 	printf("NABU LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
@@ -779,9 +780,25 @@
 		}
 		lck_mtx_unlock(&nabu_ufs_lock);
 		if (error) {
-			printf("NABU LOG: write failed (%d), stopping\n", error);
-			return;
+			/*
+			 * Once launchd mounts the root read-write and starts
+			 * hammering the UFS, a log flush can collide with root
+			 * I/O (shared DMA bounce buffer, controller busy) and
+			 * fail. Returning here killed the thread on the very
+			 * first error, so every boot only ever reached flush #1
+			 * and the whole userland part of the console never made
+			 * it to the disk ring: recovery pulls always showed
+			 * early boot only. Stay alive and retry on the next
+			 * tick instead; the ring keeps the bytes until a flush
+			 * succeeds.
+			 */
+			if (++failures == 1 || failures % 32 == 0) {
+				printf("NABU LOG: write failed (%d), retry %u\n",
+				    error, failures);
+			}
+			continue;
 		}
+		failures = 0;
 		flushed = total;
 	}
 }
